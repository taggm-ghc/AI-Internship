  "restriction_strip_regex": "[\\u200b-\\u200f\\u2060\\ufeff\\u00ad]",
  "restrictions": [
    {
      "id": "no-educational-use",
      "name": "Educational use forbidden",
      "reject_regexes": [
        "(?<![A-Za-z])(?:no|not\\s+for|not\\s+permitted\\s+for|not\\s+allowed\\s+for|prohibited\\s+for|forbidden\\s+for|not\\s+licen[sc]ed\\s+for|excludes?)\\s+(?:any\\s+)?(?:educational|teaching|classroom|academic\\s+teaching)\\s+(?:use|purposes?)(?!\\s+(?:restrictions?|limitations?))",
        "(?:educational|teaching|classroom)\\s+(?:use|purposes?)\\s+(?:is\\s+|are\\s+)?(?:strictly\\s+)?(?:prohibited|forbidden|not\\s+(?:permitted|allowed))"
      ],
      "hold_regexes": [
        "(?:educational|teaching|classroom)\\s+(?:use|purposes?)[^.\\n]{0,60}(?:unless|except|subject\\s+to|requires?|permission|prior\\s+(?:written\\s+)?consent)"
      ],
      "permit_regexes": [
        "(?<!no\\s)(?<!not\\s)(?<!never\\s)(?:educational|teaching|classroom)\\s+(?:use|purposes?)\\s+(?:is\\s+|are\\s+)?(?:permitted|allowed|welcome|free|granted)",
        "(?<!no\\s)(?<!not\\s)(?<!never\\s)(?:free|permitted|allowed|granted|available)\\s+(?:for|to)\\s+(?:educational|teaching|classroom)",
        "(?:educational|teaching|classroom)\\s+(?:use|purposes?)\\s+(?:is\\s+|are\\s+)?not\\s+(?:prohibited|forbidden|restricted)"
      ],
      "reason": "licence text forbids educational use"
    },
    {
      "id": "strictly-for-fee",
      "name": "Strictly paid / for-fee use only",
      "reject_regexes": [
        "(?:strictly|solely|exclusively|only)\\s+(?:available\\s+)?(?:for|to|against)\\s+(?:a\\s+|the\\s+)?(?:fee|payment|paying\\s+(?:customers?|users?|subscribers?)|paid\\s+(?:users?|subscribers?|customers?))",
        "(?:available|licen[sc]ed|provided)\\s+(?:strictly|solely|exclusively|only)\\s+(?:for|to)\\s+(?:a\\s+)?(?:fee|payment|paying|paid)",
        "paid[\\s\\-]+(?:access|subscribers?|licen[sc]es?|use)\\s+only",
        "(?<![A-Za-z])paid[\\s\\-]only(?![A-Za-z])"
      ],
      "hold_regexes": [
        "(?<!no\\s)(?<!not\\s)(?<!never\\s)(?:subscription|purchase|payment|fee)\\s+(?:is\\s+)?required",
        "licen[sc]ing\\s+fees?\\s+(?:apply|applies|may\\s+apply)",
        "commercial\\s+licen[sc]e\\s+(?:available|required)"
      ],
      "permit_regexes": [
        "free\\s+of\\s+charge",
        "(?<![A-Za-z])no\\s+(?:fee|charge|payment)",
        "without\\s+(?:a\\s+)?(?:fee|charge|payment)",
        "free\\s+(?:to\\s+(?:use|read|access)|for\\s+(?:educational|personal|research))",
        "open[\\s\\-]access"
      ],
      "reason": "licence text restricts use to paid/for-fee access"
    }
  ],
  "cue_window": 80,
  "cue_tail": "(?:creative\\s+commons\\s+)?",
  "cues": [
    "licen[sc]ed?\\s+(?:under|via|with|as)(?:\\s+(?:the|a|an))?(?:\\s+terms\\s+of(?:\\s+the)?)?",
