  "nd_policy": "reject",
  "nc_only_policy": "ok",
  "_nc_note": "User decision 2026-10-03: plain NC and NC-SA accepted; only ND, no-educational-use and strictly-for-fee are rejected. Set nc_only_policy to hold or reject to flip.",
  "hidden": {
    "attrs": ["hidden"],
